# Afrovanguard Academy — pretty URLs
#   /academy/                 -> index.php
#   /academy/<slug>/          -> course.php?slug=<slug>
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /academy/
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^og/([a-z0-9-]+)\.png$ og.php?slug=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^teach/?$ teach.php [L,QSA]
  RewriteRule ^teach/([a-z0-9-]+)/?$ teach.php?course=$1 [L,QSA]
  # NextGen Vanguard flagship programme (real directory; explicit so the course
  # catch-all below never treats "ngv" as a course slug).
  RewriteRule ^ngv/?$ ngv/index.php [L,QSA]
  # D'Vanguard National Summit — same arrangement: a real directory, named
  # explicitly so "dns" is never resolved as a course slug.
  RewriteRule ^dns/?$ dns/index.php [L,QSA]
  RewriteRule ^dns/og\.png$ dns/og.php [L]
  RewriteRule ^dns/summit\.ics$ dns/summit.ics.php [L]
  RewriteRule ^([a-z0-9-]+)/certificate/?$ certificate.php?course=$1 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/learn/?$ learn.php?course=$1 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/learn/([a-z0-9-]+)/?$ learn.php?course=$1&lesson=$2 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/?$ course.php?slug=$1 [L,QSA]
</IfModule>
