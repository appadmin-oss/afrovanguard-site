# Afrovanguard Academy — pretty URLs
#   /academy/                 -> index.php
#   /academy/<slug>/          -> course.php?slug=<slug>
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /academy/
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^og/([a-z0-9-]+)\.png$ og.php?slug=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^teach/?$ teach.php [L,QSA]
  RewriteRule ^teach/([a-z0-9-]+)/?$ teach.php?course=$1 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/certificate/?$ certificate.php?course=$1 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/learn/?$ learn.php?course=$1 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/learn/([a-z0-9-]+)/?$ learn.php?course=$1&lesson=$2 [L,QSA]
  RewriteRule ^([a-z0-9-]+)/?$ course.php?slug=$1 [L,QSA]
</IfModule>
