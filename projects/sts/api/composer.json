{
  "name": "appadmin-oss/sts-api",
  "description": "Street-To-Stardom · PHP API (forms, AI proxy, stats, blog) for the Astro static site.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.6",
    "league/commonmark": "^2.5"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform-check": false,
    "allow-plugins": {}
  }
}
