# Street-To-Stardom · API environment
# Copy to /api/.env on the server and fill in real credentials.
# .env should NEVER be committed; the api .htaccess already blocks public reads.

# ── Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=sts
DB_USER=
DB_PASS=

# ── AI providers ────────────────────────────────────────────────────────
# Gemini is tried first; on failure we fall through to Pollinations (no key).
GEMINI_API_KEY=

# ── SMTP (PHPMailer) ────────────────────────────────────────────────────
# Leave SMTP_HOST empty to fall back to PHP's native mail() — useful for
# first-deploy smoke testing on a host where sendmail is wired up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM=hello@streettostardom.org
SMTP_FROM_NAME=Street-To-Stardom
SMTP_REPLY_TO=

# ── Site URLs ───────────────────────────────────────────────────────────
SITE_URL=https://streettostardom.org
AFROVANGUARD_URL=https://afrovanguard.org.ng
AFROVANGUARD_DONATE_URL=https://afrovanguard.org.ng/donate
AFROVANGUARD_SPONSOR_URL=https://afrovanguard.org.ng/sponsor

# ── Inbox routing ───────────────────────────────────────────────────────
GENERAL_INBOX=hello@streettostardom.org
VOLUNTEERS_INBOX=volunteers@streettostardom.org
PARTNERSHIPS_INBOX=partnerships@streettostardom.org
SPONSORS_INBOX=sponsors@streettostardom.org
PRESS_INBOX=press@streettostardom.org
SAFEGUARDING_INBOX=safeguarding@streettostardom.org

# ── Admin + webhooks ────────────────────────────────────────────────────
# Bearer token for /api/admin/blog.php. When empty, the admin endpoint
# silently returns 404 (so a forgotten config doesn't open a door).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Shared secret used to verify HMAC-SHA256 of webhook payloads from
# Afrovanguard (set the same value on the parent site).
AFROVANGUARD_WEBHOOK_SECRET=
