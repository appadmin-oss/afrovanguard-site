# ============================================================================
#  Afrovanguard — environment configuration (TEMPLATE)
# ============================================================================
#  Copy this file to `.env` and fill in the values you need. Everything else
#  can stay blank — the site runs fine and simply disables the feature whose
#  secret is missing.
#
#  HOW IT LOADS:  lib/bootstrap.php parses this file at startup (no Composer
#  needed) and exposes every line to getenv() — so it works on plain shared /
#  cPanel hosting. A real Apache `SetEnv KEY value` (or PHP-FPM env) also works
#  and ALWAYS wins over this file; the file only fills variables not already set.
#
#  WHERE TO PUT `.env` (it holds live secrets):
#    1. BEST — one level ABOVE the web root (e.g. /home/USER/.env, beside
#       public_html). bootstrap looks there first and it is never web-served.
#    2. OK   — in the app root beside lib/, IF the server refuses to serve it
#       (a stray https://your-site/.env would leak every secret).
#    3. Or set AV_ENV_FILE=/abs/path/.env to load from an explicit location.
#
#  SYNTAX:  KEY=value · inline `# comments` · 'single' or "double" quotes ·
#           optional `export ` prefix. Quote values with spaces or `#` in them.
#           A blank value is treated as "not set".
#
#  Only the four [REQUIRED] secrets are needed to clear the
#  "Server configuration error" and enable email + donations.
#  Studio → System shows, live, which of these are configured.
# ============================================================================


# ── REQUIRED secrets ────────────────────────────────────────────────────────
AV_ADMIN_TOKEN=                 # long random string — gates Studio (/admin). Generate:
                                #   php -r "echo bin2hex(random_bytes(32));"
AV_SMTP_PASSWORD=               # SMTP password — email verification & notifications
AV_PAYSTACK_PK=                 # Paystack PUBLIC key (pk_live_… / pk_test_…)
AV_PAYSTACK_SK=                 # Paystack SECRET key (sk_live_… / sk_test_…)


# ── Database (default: SQLite, zero-config) ─────────────────────────────────
AV_DB_DRIVER=sqlite             # sqlite | mysql | pgsql
# AV_DB_PATH=/path/db/diary.sqlite   # sqlite only (defaults to <root>/db/diary.sqlite)
# For mysql/pgsql, set either AV_DB_DSN, or the discrete parts below:
# AV_DB_DSN=
# AV_DB_HOST=127.0.0.1
# AV_DB_PORT=3306                # 3306 mysql · 5432 pgsql
# AV_DB_NAME=afrovanguard
# AV_DB_USER=
# AV_DB_PASS=
# (cutover: php db/migrate.php --to=mysql --apply-schema … — see docs/db-portability.md)


# ── Email (SMTP) ────────────────────────────────────────────────────────────
# A built-in SMTP client sends authenticated mail — no PHPMailer/Composer needed.
# Studio → System → "Send a test email" verifies delivery end-to-end.
SMTP_HOST=smtp.gmail.com        # Gmail/Workspace: smtp.gmail.com
SMTP_PORT=587                   # 587 = STARTTLS (default) · 465 = SSL
SMTP_USERNAME=you@afrovanguard.org.ng    # the FULL Google address you authenticate as
# SMTP_PASSWORD mirrors AV_SMTP_PASSWORD above.
#   ⚠ Gmail/Workspace: this MUST be a 16-char *App Password*, NOT your login
#     password (enable 2-Step Verification → myaccount.google.com/apppasswords).
# SMTP_SECURE=tls               # tls (587, default) | ssl (465) | none (internal relay)
# SMTP_VERIFY=true              # set false only for self-signed internal relays
FROM_EMAIL=donations@afrovanguard.org.ng # Sender for DONATION receipts ONLY. MUST equal
                                #   SMTP_USERNAME or a verified send-as alias, else Gmail
                                #   rewrites/blocks the From.
FROM_NAME=Afrovanguard
ADMIN_EMAIL=cacentre@afrovanguard.org.ng  # where admin notifications land
# GENERAL sender — announcements, sign-in codes and all NON-donation mail send
# from here, so donations@ is reserved for donation receipts. Defaults to
# ADMIN_EMAIL. MUST also be a mailbox the SMTP account may send as (itself or a
# verified Gmail "send-as" alias), or Gmail will rewrite it to the auth account.
# FROM_GENERAL=hello@afrovanguard.org.ng
# FROM_GENERAL_NAME=Afrovanguard


# ── Payments ────────────────────────────────────────────────────────────────
# Paystack keys are the [REQUIRED] block above (PAYSTACK_PUBLIC_KEY /
# PAYSTACK_SECRET_KEY are accepted as aliases for AV_PAYSTACK_PK / _SK).
FLW_PUBLIC_KEY=                 # optional — Flutterwave (secondary provider)
FLW_SECRET_KEY=
AV_MEMBERSHIP_NGN=5000          # Academy membership price (NGN)


# ── AI — the @Afrovanguard community bot & Chioma site guide ─────────────────
# The bot/guide can run on EITHER provider. Selection:
#   • AV_AI_PROVIDER picks it explicitly: anthropic | groq.
#   • If unset, it auto-detects — Anthropic if ANTHROPIC_API_KEY is set,
#     otherwise Groq if GROQ_API_KEY is set. Set just the key you have.
# AV_AI_PROVIDER=               # anthropic | groq  (optional; auto-detected if blank)
ANTHROPIC_API_KEY=              # Claude — console.anthropic.com
GROQ_API_KEY=                   # Groq (fast Llama/Mixtral) — console.groq.com
# AV_AI_MODEL=                  # override the model. Defaults:
#                               #   anthropic → claude-opus-4-8
#                               #   groq      → llama-3.3-70b-versatile
# AV_AI_BASE_URL=               # override the endpoint (gateway / Bedrock / proxy / mock)

# ── Chioma — the site's floating AI guide / executive assistant ─────────────
# Chioma replies in this order: (1) YOUR agent webhook, if AV_CHIOMA_AGENT_URL
# is set; (2) the AI provider above, in Chioma's voice; (3) a scripted guide.
#
# CONNECT A MAKE.COM AI AGENT (recommended — makes Chioma a real assistant):
#   1. Make scenario: "Custom webhook" trigger → copy its URL here.
#   2. Add an "AI Agent" module with your tools; key its memory on `session`
#      and give it `user` + `context` from the webhook payload.
#   3. End with "Webhook response":  {"reply": "…"}  — optionally add
#      {"actions":[{"label":"Open donate","url":"/donate.html"}]} (≤6) and the
#      widget renders them as tappable next-step buttons under the reply.
#
#   Your webhook receives POST {message, history, context, session,
#   user:{name,email,member,role}|null, persona, source} — `user` is the
#   signed-in account (portal/academy), so the agent knows who it's helping.
#   Reply JSON: {reply|text|message|output|response|answer}, an OpenAI
#   {choices:[{message:{content}}]} body, or plain text.
# AV_CHIOMA_AGENT_URL=          # e.g. https://hook.eu2.make.com/xxxxxxxxxxxx
# AV_CHIOMA_AGENT_KEY=          # optional — sent as `Authorization: Bearer …`


# ── Identity & Google Workspace ─────────────────────────────────────────────
AV_ORG_DOMAIN=afrovanguard.org.ng        # the Workspace domain recognised as org members
AV_GOOGLE_CLIENT_ID=            # optional — "Continue with Google"
AV_GOOGLE_CLIENT_SECRET=
# Workspace launchpad tiles auto-derive from AV_ORG_DOMAIN; override if needed:
# AV_WS_MAIL_URL=   AV_WS_CHAT_URL=   AV_WS_MEET_URL=   AV_WS_CALENDAR_URL=
# AV_WS_DRIVE_URL=  AV_WS_GROUPS_URL= AV_WS_ADMIN_URL=
# In-portal read-only embeds:
# AV_WS_CALENDAR_ID=team@afrovanguard.org.ng   # or full AV_WS_CALENDAR_EMBED=https://calendar.google.com/...
# AV_WS_TZ=Africa/Lagos
# AV_WS_DRIVE_FOLDER_ID=                        # a Drive folder shared "anyone with the link"
# AV_WS_COMMUNITIES=[{"name":"All-hands","url":"https://chat.google.com/room/AAAA"}]
# Live Workspace API reads (events/files/directory) need AV_GDRIVE_SERVICE_ACCOUNT
# (below) + a delegated admin to impersonate:
# AV_WS_SUBJECT=admin@afrovanguard.org.ng       # domain-wide delegation, for the Directory API


# ── Storage (optional — falls back to local /uploads) ───────────────────────
CLOUDINARY_CLOUD_NAME=          # images
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AV_GDRIVE_SERVICE_ACCOUNT=      # documents — path to, or JSON of, a service-account key
AV_GDRIVE_FOLDER_ID=            # the shared Drive folder id


# ── URLs (optional — subdomain routing) ─────────────────────────────────────
# AV_ACADEMY_URL=https://afrovanguard.org.ng/academy
# AV_PORTAL_URL=https://members.afrovanguard.org.ng


# ── Security & background jobs ──────────────────────────────────────────────
# AV_TRUSTED_PROXIES=           # extra CIDRs trusted for client-IP (Cloudflare ranges built in)
# Webhook retry queue drains via cron. With shell access:
#     */1 * * * * /usr/bin/php /path/to/site/db/webhooks_run.php
# WITHOUT shell access (shared cPanel), point a scheduler at the web runner:
#     */5 * * * * curl -fsS "https://your-site/tasks/cron.php?key=YOUR_KEY"
# AV_CRON_KEY=                  # random 8+ char string gating /tasks/cron.php (falls back to AV_ADMIN_TOKEN)


# ── Street-To-Stardom CEO sub-app (projects/sts/ceo) ────────────────────────
# STS_AI_ACCESS_KEY=            # gate for the Gemini proxy (ai.php)
# STS_DATA_DIR=                 # data dir OUTSIDE the web root
# STS_APPS_SCRIPT_KEY=          # shared key matching the Apps Script SHARED_KEY
# GEMINI_API_KEY=               # billable — keep server-side only


# ── Read-aloud (Diary "Listen" — neural voice) ──────────────────────────────
# When set, the Diary narrates articles with a real neural voice (cached
# server-side) instead of the browser's robotic speech engine.
# AV_TTS_ENGINE=openai          # openai | elevenlabs | mock (test tone, no cost)
# AV_TTS_API_KEY=               # engine API key (falls back to AV_OPENAI_API_KEY)
# AV_TTS_VOICE=nova             # openai: alloy|echo|fable|onyx|nova|shimmer
# AV_TTS_VOICE_ID=              # elevenlabs voice id
# AV_TTS_MODEL=                 # optional model override (openai default tts-1)
