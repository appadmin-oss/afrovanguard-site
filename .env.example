# ============================================================================
#  Afrovanguard — environment configuration (TEMPLATE)
# ----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in the values. lib/bootstrap.php loads it
#  automatically (no Composer needed) and exposes every line to getenv() — so
#  this works on plain shared/cPanel hosting. Inline `# comments`, quotes, and
#  `export ` prefixes are all fine.
#
#  WHERE TO PUT `.env` (it holds live secrets):
#    • BEST: one level ABOVE the web root (e.g. /home/USER/.env, next to
#      public_html). bootstrap looks there first, and it is never web-served.
#    • OK: in the app root beside lib/ — but make sure the server refuses to
#      serve it (a stray https://your-site/.env would leak every secret).
#    • Or point AV_ENV_FILE=/abs/path/.env to load from an explicit location.
#  A real Apache `SetEnv KEY value` (or PHP-FPM env) still works too, and ALWAYS
#  wins over the file — the file only fills variables that aren't already set.
#
#  The Studio → System page shows, live, which of these are configured.
#  Only the four marked [REQUIRED] are needed to clear the
#  "Server configuration error" and enable email + donations.
# ============================================================================

# ── Required secrets ────────────────────────────────────────────────────────
AV_ADMIN_TOKEN=                 # [REQUIRED] long random string — Studio (/admin) break-glass superadmin
AV_SMTP_PASSWORD=               # [REQUIRED] SMTP password — email verification & notifications
AV_PAYSTACK_PK=                 # [REQUIRED] Paystack public key (pk_live_… / pk_test_…)
AV_PAYSTACK_SK=                 # [REQUIRED] Paystack secret key (sk_live_… / sk_test_…)

# ── Default Super Admin ─────────────────────────────────────────────────────
# A single account is auto-provisioned on first sign-in so a fresh deploy has a
# working superadmin (full Studio access → manage every other admin & manager).
# It is created BOTH as admin_users(superadmin) AND lms_users(role=admin).
AV_SUPERADMIN_EMAIL=mamcareer@afrovanguard.org.ng   # who the default super admin is
AV_SUPERADMIN_NAME=Super Admin                       # display name
# Set an exact sign-in password here (recommended). If you leave it blank, a
# strong password is generated once — reveal it with:  php db/seed_admin.php
AV_SUPERADMIN_PASSWORD=
#   ↳ If Google sign-in is configured, this org-domain account signs in with
#     "Continue with Google" instead and still lands as superadmin. The break-
#     glass AV_ADMIN_TOKEN at /admin always works regardless of email config.

# ── Database (default: SQLite, zero-config) ─────────────────────────────────
AV_DB_DRIVER=sqlite             # sqlite | mysql | pgsql
# AV_DB_STRICT=1                # production: if the primary mysql/pgsql DB is
#                               # unreachable, FAIL LOUDLY instead of silently
#                               # falling back to a local (possibly empty) SQLite.
# AV_DB_PATH=/path/db/diary.sqlite   # sqlite only (defaults to <root>/db/diary.sqlite)
# For mysql/pgsql, set either AV_DB_DSN, or the discrete parts below:
# AV_DB_DSN=
# AV_DB_HOST=127.0.0.1
# AV_DB_PORT=3306                # 3306 mysql · 5432 pgsql
# AV_DB_NAME=afrovanguard
# AV_DB_USER=
# AV_DB_PASS=
# (cutover with: php db/migrate.php --to=mysql --apply-schema … — see docs/db-portability.md)

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# A built-in SMTP client sends authenticated mail with NO PHPMailer/Composer
# needed. These are read from env now (set via .htaccess SetEnv) or config.php.
# Studio → System → "Send a test email" verifies delivery end-to-end.
SMTP_HOST=smtp.gmail.com        # Gmail/Workspace: smtp.gmail.com
SMTP_PORT=587                   # 587 = STARTTLS (default) · 465 = SSL
SMTP_USERNAME=you@afrovanguard.org.ng   # the FULL Google address you authenticate as
# SMTP_PASSWORD mirrors AV_SMTP_PASSWORD above.
#   ⚠ Gmail/Workspace: this MUST be a 16-char *App Password*, NOT your login
#     password (enable 2-Step Verification → myaccount.google.com/apppasswords).
#     A normal password fails with "Username and Password not accepted".
# SMTP_SECURE=tls               # tls (587, default) | ssl (465) | none (internal relay)
# SMTP_VERIFY=true              # set false only for self-signed internal relays
FROM_EMAIL=you@afrovanguard.org.ng      # MUST equal SMTP_USERNAME or a verified "Send mail as" alias,
                                #   else Gmail rewrites/blocks the From. Defaults to SMTP_USERNAME.
FROM_NAME=Afrovanguard
ADMIN_EMAIL=cacentre@afrovanguard.org.ng

# ── Payments ────────────────────────────────────────────────────────────────
# PAYSTACK_PUBLIC_KEY / PAYSTACK_SECRET_KEY also accepted (AV_PAYSTACK_PK/SK are aliases)
FLW_PUBLIC_KEY=                 # optional — Flutterwave
FLW_SECRET_KEY=
AV_MEMBERSHIP_NGN=5000          # Academy membership price (NGN)
# Membership DUES (the "How Afrovanguard Works" framework contribution) — distinct
# from the Academy price above. Voluntary from Level A, mandatory from Level C.
AV_DUES_MONTHLY_NGN=1000        # dues — per month
AV_DUES_ANNUAL_NGN=12000        # dues — per year
# AUTO-RENEWING monthly dues (optional). In the Paystack dashboard create a Plan
# (interval = Monthly, amount = AV_DUES_MONTHLY_NGN) and paste its plan_code here.
# When set, "Subscribe monthly" starts a recurring subscription; renewals are
# applied via the charge.success webhook. Point the Paystack webhook at
# /academy/pay.php. Leave blank for one-time monthly charges.
# AV_DUES_PLAN_CODE=PLN_xxxxxxxxxx

# ── AI — the Afrovanguard community bot (Claude) ────────────────────────────
ANTHROPIC_API_KEY=              # enables AI replies for the @Afrovanguard bot (console.anthropic.com)
# AV_AI_MODEL=claude-opus-4-8   # default; set claude-haiku-4-5 or claude-sonnet-4-6 to cut cost
# AV_AI_BASE_URL=               # override the Messages endpoint (gateway / Bedrock / proxy)
# AV_ERROR_POEMS=1              # dynamic Claude-written poems on error pages (set 0 for curated-only).
                               # Generated in the background + cached; warm via tools/warm-error-poems.php (cron).

# ── Chioma — the site's context-aware AI guide (the floating assistant) ──────
# Chioma replies in this order: (1) YOUR AI agent, if AV_CHIOMA_AGENT_URL is set;
# (2) Claude (ANTHROPIC_API_KEY above), in Chioma's voice; (3) a scripted guide.
# Point AV_CHIOMA_AGENT_URL at your agent's webhook to make YOUR agent be Chioma.
#   Your webhook receives: POST {message, history:[{role,text}], context:{title,path,section}, persona, source}
#   and may reply with JSON {reply|text|message|output|response|answer}, an
#   OpenAI {choices:[{message:{content}}]} body, or plain text.
# AV_CHIOMA_AGENT_URL=          # e.g. https://your-agent.example.com/chioma
# AV_CHIOMA_AGENT_KEY=          # optional — sent as `Authorization: Bearer …` to your webhook
# (To converse with Chioma FROM your agent instead, issue an app token in
#  Studio → Webhooks with the `bot:ask` scope and POST to
#  /integrations/api.php?action=chioma.ask  {message, history?, page?}.)

# ── Identity & Google Workspace ─────────────────────────────────────────────
AV_ORG_DOMAIN=afrovanguard.org.ng
AV_GOOGLE_CLIENT_ID=            # optional — "Continue with Google" AND per-user Workspace connect
AV_GOOGLE_CLIENT_SECRET=
# Per-user Workspace (enterprise: the site acts AS each member on THEIR Gmail /
# Calendar / Drive). Members connect their own account at /auth/google/connect
# (offline access → encrypted refresh token in `google_connections`). Uses the
# SAME OAuth client above; add these authorized scopes on the OAuth consent
# screen. Refresh tokens are encrypted with APP_KEY (set a strong APP_KEY!).
# AV_GWS_USER_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/chat.spaces.readonly https://www.googleapis.com/auth/chat.messages
# Team Chat (live Google Chat in the portal) needs the two chat.* scopes above
# AND the "Google Chat API" enabled in your Google Cloud project. Members who
# connected before will re-consent once to grant Chat access.
# AV_GWS_CONNECT_ON_SIGNIN=1   # default on: ordinary Google sign-in ALSO requests offline
#                              # Workspace access, so one sign-in authenticates AND connects.
#                              # Set 0 to keep sign-in lightweight (connect only via /workspace).
# Workspace launchpad (member portal) — tiles auto-derive from AV_ORG_DOMAIN; override if needed:
# AV_WS_MAIL_URL=   AV_WS_CHAT_URL=   AV_WS_MEET_URL=   AV_WS_CALENDAR_URL=
# AV_WS_DRIVE_URL=  AV_WS_GROUPS_URL= AV_WS_ADMIN_URL=
# In-portal embeds (read-only):
# AV_WS_CALENDAR_ID=team@afrovanguard.org.ng     # or a full AV_WS_CALENDAR_EMBED=https://calendar.google.com/...
# AV_WS_TZ=Africa/Lagos
# AV_WS_DRIVE_FOLDER_ID=                          # a Drive folder shared "anyone with the link"
# AV_WS_COMMUNITIES=[{"name":"All-hands","url":"https://chat.google.com/room/AAAA"}]   # fallback if Studio has none
# REAL Workspace API sync (live events/files/directory + creating Meet events) —
# needs the service-account key in AV_GDRIVE_SERVICE_ACCOUNT (below) + these:
# AV_WS_SUBJECT=admin@afrovanguard.org.ng         # admin to impersonate (domain-wide delegation)
# AV_WS_CALENDAR_WRITE=1                           # 1 = auto-create Calendar events + Meet links (default on when configured); 0 = read-only
# AV_WS_TZ=Africa/Lagos                            # timezone for created events
#   ↳ Enable in Google Admin → Security → API controls → Domain-wide delegation,
#     authorising the service account's client ID for the FULL-sync scopes:
#       https://www.googleapis.com/auth/calendar                     (create/update Meet events)
#       https://www.googleapis.com/auth/drive.readonly               (read transcripts)
#       https://www.googleapis.com/auth/admin.directory.user.readonly (directory → members sync)
#       https://www.googleapis.com/auth/admin.directory.group.readonly
#     (calendar.readonly + drive.metadata.readonly still work for read-only setups.)
#   ↳ Run once configured:  php tools/gws-sync.php probe   (then `users` to provision members)
#   ↳ Full setup guide: docs/google-workspace.md
# AV_WS_BASE_URL=  AV_WS_TOKEN_URL=                # test/proxy overrides (leave blank in prod)

# ── Storage (optional — fall back to local /uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AV_GDRIVE_SERVICE_ACCOUNT=      # path to / JSON of a service-account key
AV_GDRIVE_FOLDER_ID=

# ── URLs (optional — subdomain routing) ─────────────────────────────────────
# AV_ACADEMY_URL=https://afrovanguard.org.ng/academy
# AV_PORTAL_URL=https://members.afrovanguard.org.ng

# ── Security ────────────────────────────────────────────────────────────────
# AV_TRUSTED_PROXIES=            # extra CIDRs trusted for client-IP (Cloudflare ranges are built in)
# Dedicated signing key for admin cookies + CSRF tokens. Set this to a long
# random string (php -r "echo bin2hex(random_bytes(32));") so you can rotate the
# break-glass AV_ADMIN_TOKEN WITHOUT logging every admin out. If unset, signing
# falls back to AV_ADMIN_TOKEN (legacy single-secret behaviour).
# AV_APP_KEY=
# Where PII data stores (donations.json, contacts.json) are kept. STRONGLY
# recommended: a directory ABOVE the web root so it can never be web-served.
# If unset, they live in <root>/db/private (already denied by the server).
# AV_PRIVATE_DIR=/home/USER/afrovanguard-private
# Share mentor EMAIL over the scoped integrations API (mentors.directory). The
# stable `ref` is always shared; set this to 0 to withhold email PII from the
# sister-site mirror (it can dedupe on `ref`).
# AV_MENTORS_SHARE_EMAIL=1

# ── Webhook retry queue (no-SSH hosts) ──────────────────────────────────────
# Webhook deliveries retry with backoff. With shell cron:
#     */1 * * * * /usr/bin/php /path/to/site/db/webhooks_run.php
# WITHOUT shell access (shared cPanel), point a scheduler at the web runner:
#     */5 * * * * curl -fsS "https://your-site/tasks/cron.php?key=YOUR_KEY"
# (free schedulers: cron-job.org, UptimeRobot.) AV_CRON_KEY gates that URL;
# if unset it falls back to AV_ADMIN_TOKEN. Studio → Webhooks → "Run queue now"
# also drains it manually.
# AV_CRON_KEY=                   # random 8+ char string for /tasks/cron.php

# ── Accountability rules (Studio → Rules & AI) ────────────────
# The rules engine (lib/AvRules.php) holds every threshold the accountability
# engine obeys: meeting cadence, escalation steps, relationship-health bands,
# the O–G ladder and its promotion criteria. Afrovanguard's leadership owns
# these numbers, so the normal place to set them is Studio → Rules & AI, which
# validates each value and stores it in the database.
#
# The keys below are a FALLBACK for deployments that prefer configuration in
# files. Resolution order is:  Studio override  →  this env var  →  the built-in
# default. So anything set here is used until someone changes it in the Studio,
# and the Studio then wins. Leave them all commented out to use the defaults.
#
# The env name is the rule key upper-cased with dots as underscores, prefixed
# AV_ — e.g. the rule `mentorship.cadence_days` reads AV_MENTORSHIP_CADENCE_DAYS.
# Every value is validated and out-of-range entries are IGNORED (the default is
# used instead), so a typo here degrades safely rather than corrupting policy.
#
# AV_MENTORSHIP_CADENCE_DAYS=7             # expected mentor/mentee meeting interval
# AV_MENTORSHIP_REMINDER_LEAD_HOURS=24     # how far ahead reminders go out
# AV_MENTORSHIP_INACTIVE_DAYS=21           # no session for this long = inactive
# AV_MENTORSHIP_ACTIVE_MENTEE_REQUIRES_DAYS=30   # window that makes a mentee "active"
# AV_HEALTH_AMBER_ATTENDANCE_PCT=70        # attendance under this = Amber
# AV_HEALTH_RED_ATTENDANCE_PCT=40          # attendance under this = Red (must be < Amber)
# AV_HEALTH_RED_MISSED_STREAK=3            # consecutive misses that force Red
# AV_ESCALATION_STEPS=3                    # misses handled before leadership is told
# AV_ESCALATION_NOTIFY_CHAIN=1             # inform the mentor's own mentor on the last step
# AV_ESCALATION_COOLDOWN_DAYS=7            # minimum gap between escalations on one pairing
# AV_ESCALATION_TONE=supportive            # supportive | neutral | firm
# AV_LEVELS_LADDER=O,A,B,C,D,E,F,G         # the progression, lowest first
# AV_LEVELS_ACTIVE_MENTEES_FOR_A=2         # ACTIVE mentees needed for Level A
# AV_LEVELS_REQUIRE_MULTIPLICATION=1       # levels above A need mentees who mentor
# AV_LEVELS_MIN_DAYS_AT_LEVEL=90           # tenure floor before the next level
# AV_LEVELS_MIN_ATTENDANCE_PCT=85          # meeting consistency for a recommendation
# AV_LEVELS_MIN_COMMITMENT_PCT=90          # commitment completion for a recommendation
# AV_LEVELS_AUTO_PROMOTE=0                 # KEEP 0 — the AI recommends, leadership decides
# AV_COMMITMENTS_DEFAULT_DUE_DAYS=7        # deadline for an undated action item
# AV_COMMITMENTS_OVERDUE_GRACE_DAYS=1      # grace before a commitment is chased
# AV_COMMITMENTS_REQUIRE_MISS_REASON=1     # ask "why?" on a miss
# AV_COMMITMENTS_AUTO_ASSIGN_OWNER=0       # KEEP 0 — confirm before assigning work to someone
# AV_MEETINGS_AI_AGENDA=1                  # draft agendas for meetings that have none
# AV_MEETINGS_WARN_MINUTES=20,10,5         # "minutes remaining" warning points
# AV_AI_ENABLED=1                          # master switch for every AI call
# AV_AI_CHARACTER_SCORES=0                 # KEEP 0 — never reduce character to a number
# AV_AI_TONE=warm                          # warm | neutral | formal

# ── Street-To-Stardom CEO sub-app (projects/sts/ceo) ────────────────────────
# STS_AI_ACCESS_KEY=            # gate for the Gemini proxy (ai.php)
# STS_DATA_DIR=                 # data dir OUTSIDE the web root
# STS_APPS_SCRIPT_KEY=          # shared key matching the Apps Script SHARED_KEY
# GEMINI_API_KEY=               # billable — keep server-side only

# ── Read-aloud (Diary "Listen" — human-like neural voice) ───────────────────
# When set, the Diary reader narrates articles with a real neural voice (cached
# server-side, played via <audio> on every browser) instead of the robotic
# browser speech engine. Leave blank to fall back to the browser reader.
# AV_TTS_ENGINE=elevenlabs      # openai | elevenlabs | mock (test tone, no cost)
# AV_TTS_API_KEY=               # engine API key (falls back to AV_OPENAI_API_KEY)
# AV_TTS_VOICE=nova             # openai: alloy|echo|fable|onyx|nova|shimmer
#
# ElevenLabs (recommended — most natural narration):
#   AV_TTS_ENGINE=elevenlabs
#   AV_TTS_API_KEY=sk_...            # your ElevenLabs API key
#
# For a PROFESSIONAL, WELL-ARTICULATED NIGERIAN VOICE:
#   1. In ElevenLabs → Voices → Voice Library, search "Nigerian" (e.g. warm,
#      articulate reads such as "Ezinne", "Femi" or another Nigerian narrator).
#   2. Click "Add to my voices", open it, and copy its Voice ID.
#   3. Paste it below and use the multilingual model (best for the accent):
# AV_TTS_VOICE_ID=<your-nigerian-voice-id>
# AV_TTS_MODEL=eleven_multilingual_v2    # best accent fidelity (or eleven_turbo_v2_5 = faster/cheaper)
# (Without a key, the on-page reader falls back to the browser voice and now
#  prefers an English (Nigeria) voice automatically wherever the device has one.)
# AV_TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # fallback default voice ("Rachel")
# AV_TTS_STABILITY=0.5             # 0..1  steadiness vs. expressiveness
# AV_TTS_SIMILARITY=0.75           # 0..1  closeness to the source voice
# AV_TTS_STYLE=0.0                 # 0..1  style exaggeration
#
# (OpenAI: AV_TTS_MODEL default tts-1; use tts-1-hd for higher quality.)
