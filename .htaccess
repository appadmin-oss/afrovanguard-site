# ============================================================================
#  Afrovanguard — root server configuration.
#
#  Once WordPress is removed this becomes the SOLE root .htaccess. It holds NO
#  secrets (configuration lives in a .env ABOVE the web root, or in real Apache
#  SetEnv / PHP-FPM env), so it is safe to keep in version control.
#
#  DEPLOY NOTE: activate this only when WordPress is gone from the web root —
#  it takes the place of WordPress's own root .htaccess.
# ============================================================================

# Serve the static homepage first, then PHP directory indexes. Subfolders that
# have no .htaccess of their own (community/, mentorship/, people/, blog/)
# inherit this, so e.g. /community/ correctly resolves to community/index.php.
DirectoryIndex index.html index.php

# Never expose a directory listing.
Options -Indexes

RewriteEngine On

# Always allow ACME / domain-verification challenges (SSL renewal, site verify).
RewriteRule ^\.well-known/ - [L]

# Server-side PHP libraries are require()d, never requested directly over HTTP.
RewriteRule ^lib/  - [F,L]
RewriteRule ^db/   - [F,L]
RewriteRule ^data/ - [F,L]

# ── Clean URLs (work WITHOUT a file extension) ──────────────────────────────
# Consolidated in the ROOT so routing works even when per-directory .htaccess
# files aren't honored or deployed on the host. Real files and directories are
# always served as-is (so /diary/, /academy/, css, js, images, *.php all work).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Legacy WordPress blog → Diary (permanent)
RewriteRule ^blog/?(.*)$ /diary/$1 [R=301,L,QSA]

# Diary
RewriteRule ^diary/sitemap\.xml$ diary/sitemap.php [L]
RewriteRule ^diary/feed\.xml$ diary/feed.php [L]
RewriteRule ^diary/og/([a-z0-9-]+)\.png$ diary/og.php?slug=$1 [L,QSA]
RewriteRule ^diary/me/?$ diary/me.php [L,QSA]
RewriteRule ^diary/series/([a-z0-9-]+)/?$ diary/series.php?slug=$1 [L,QSA]
RewriteRule ^diary/([a-z0-9-]+)/?$ diary/article.php?slug=$1 [L,QSA]

# Academy  (/academy/ and /academy/studio/ are real dirs → served above)
RewriteRule ^academy/sitemap\.xml$ academy/sitemap.php [L]
RewriteRule ^academy/og/([a-z0-9-]+)\.png$ academy/og.php?slug=$1 [L,QSA]
RewriteRule ^academy/teach/?$ academy/teach.php [L,QSA]
RewriteRule ^academy/teach/([a-z0-9-]+)/?$ academy/teach.php?course=$1 [L,QSA]
RewriteRule ^academy/([a-z0-9-]+)/certificate/?$ academy/certificate.php?course=$1 [L,QSA]
RewriteRule ^academy/([a-z0-9-]+)/learn/?$ academy/learn.php?course=$1 [L,QSA]
RewriteRule ^academy/([a-z0-9-]+)/learn/([a-z0-9-]+)/?$ academy/learn.php?course=$1&lesson=$2 [L,QSA]
RewriteRule ^academy/([a-z0-9-]+)/?$ academy/course.php?slug=$1 [L,QSA]

# People profiles: /people/<id> or /people/<id>-<slug>
RewriteRule ^people/([0-9]+)(?:-[^/]*)?/?$ people/index.php?id=$1 [L,QSA]

# Google sign-in endpoints
RewriteRule ^auth/google/(start|callback|connect|disconnect)/?$ auth/google.php?action=$1 [L,QSA]

# Google real-time push receiver (Calendar/Drive watch channels)
RewriteRule ^webhooks/google/?$ webhooks/google.php [L,QSA]

# Extension-less root pages: /about → about.html, /donate → donate.html, …
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9_-]+)/?$ /$1.html [L]
# …and /name → name.php when only a PHP file exists by that name
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9_-]+)/?$ /$1.php [L,QSA]

# ── Deny secrets, configs, VCS metadata, dumps and raw source/docs ──────────
# Matches dotfiles (.env, .git*, .htaccess … but NOT .well-known), config.php /
# composer.*, and a set of never-serve extensions.
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.(?!well-known)|^(config|composer)\.|\.(env|ini|sqlite|sqlite-wal|sqlite-shm|sql|log|lock|bak|dist|sh|md|yml|yaml|example)$)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(^\.(?!well-known)|^(config|composer)\.|\.(env|ini|sqlite|sqlite-wal|sqlite-shm|sql|log|lock|bak|dist|sh|md|yml|yaml|example)$)">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# ── Deny the runtime data stores written to the web root ────────────────────
# contacts.json (contact + newsletter submissions) and donations.json (donor
# records) are PII and must never be web-served. They are NOT covered by the
# extension list above (.json is intentionally not blanket-denied — e.g.
# .well-known/*.json verification files must still serve), so deny them by name.
<IfModule mod_authz_core.c>
  <FilesMatch "^(contacts|donations)\.json$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(contacts|donations)\.json$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# ── Security headers + Content-Security-Policy ──────────────────────────────
# The CSP allows exactly what the site loads: same-origin + inline (for the
# app's own inline scripts/styles) plus the specific third parties in use —
# jsdelivr (CDN/TinyMCE), Google/AJAX libs, Paystack (payments), Cloudinary
# (uploads) and the whitelisted embed hosts (see lib/security.php::av_embed_hosts).
# `unset` before `set` guarantees this replaces any CSP a host security suite
# (e.g. Imunify360/ModSecurity) injects upstream.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://cacentre.afrovanguard.org.ng https://checkout.paystack.com; img-src 'self' data: blob: https:; media-src 'self' https: blob:; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://ajax.googleapis.com https://platform.twitter.com https://www.instagram.com https://www.tiktok.com https://platform.instagram.com https://js.paystack.co; connect-src 'self' https://api.cloudinary.com https://api.paystack.co https://cdn.jsdelivr.net; frame-src 'self' https://checkout.paystack.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://open.spotify.com https://w.soundcloud.com https://player.soundcloud.com https://platform.twitter.com https://www.instagram.com https://www.tiktok.com https://www.google.com https://maps.google.com https://docs.google.com https://drive.google.com https://calendar.google.com https://flo.uri.sh https://public.flourish.studio https://www.facebook.com https://web.facebook.com https://anchor.fm https://embed.music.apple.com https://www.canva.com https://datawrapper.dwcdn.net"
</IfModule>

AddDefaultCharset UTF-8

# ── Optional: send unknown WordPress-era URLs to the homepage instead of 404 ─
# Left commented so it never surprises you; enable if old /?p=… or /blog links
# matter for SEO. Real files/dirs are always served as-is.
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^ /index.html [L]
