# Authentication endpoints — a real /auth/ folder, so WordPress never touches it.
DirectoryIndex google.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /auth/
  # /auth/google/{start,callback,connect,disconnect} → google.php?action=…
  # NOTE: this per-directory file shadows the root .htaccess for requests that
  # resolve into /auth/, so it MUST list every action the root rule does — or the
  # missing ones (e.g. connect) 404. Keep this in sync with the root .htaccess.
  RewriteRule ^google/(start|callback|connect|disconnect)/?$ google.php?action=$1 [L,QSA]
  # real files served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>
