# ── Credentials & server config — NEVER commit ────────────────────────
config.php
.env
.env.*
!.env.example
.htaccess
.htpasswd
# (the routing-only diary/.htaccess is force-added — it holds no secrets)

# ── Diary runtime database (auto-created from db/schema.sql + db/content.php) ──
db/diary.sqlite
db/diary.sqlite-wal
db/diary.sqlite-shm

# ── NextGen Vanguard runtime database (separate, auto-created by lib/NgvDb.php) ──
db/ngv.sqlite
db/ngv.sqlite-wal
db/ngv.sqlite-shm

# ── Donor / submission data ────────────────────────────────────────────
donations.json
contacts.json
# The data itself is never committed; the deny rule beside it is, so a fresh
# deploy is protected before the first form submission creates the folder.
projects/sts/ceo/api/data/*
!projects/sts/ceo/api/data/.htaccess
projects/sts/ceo/api/error_log

# ── Rate-limit state files ─────────────────────────────────────────────
*.rl

# ── PHP dependencies ───────────────────────────────────────────────────
# vendor/ is COMMITTED on purpose: this site is git-deployed to shared hosting
# (cPanel) that has no Composer, so the PHPMailer dependency must ship in-repo.
# Run `composer install` to reproduce it locally.

# ── OS / editor noise ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Diary OG image cache (regenerated on demand) ──
db/cache/

# ── User-uploaded media (Cloudinary fallback) ──
# The files are ignored; the no-execute .htaccess is tracked and must stay so.
uploads/*
!uploads/.htaccess

# ── Generated read-aloud audio cache ───────────────────────────────────
data/tts/
# Signed NGV MoUs, scanned at the registration desk: a date of birth and two
# people's signatures each. Never in the repository.
data/ngv-mou/

# Private PII data stores (donations/contacts) — never commit
db/private/

# Africa GATES events, cached by lib/AvEvents.php
data/afg-events.json
